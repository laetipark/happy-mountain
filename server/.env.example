# Copy to .env.local. Never commit real REST/service keys.
HOST=127.0.0.1
PORT=8080
# Relative paths resolve from server/, not the shell working directory.
STATIC_ROOT=../mobile/build/web

# This JavaScript key is public by design; register the website domain in Kakao.
KAKAO_JAVASCRIPT_APP_KEY=
# These two keys remain on the server. Do not put them in Flutter web defines.
KAKAO_REST_API_KEY=
WEATHER_API_KEY=

# Optional live test, disabled unless explicitly set to 1.
RUN_LIVE_HISTORY_TEST=0
